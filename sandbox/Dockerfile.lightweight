FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HOME=/home/ubuntu \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

RUN sed -i \
        -e 's|deb.debian.org/debian|mirrors.aliyun.com/debian|g' \
        -e 's|deb.debian.org/debian-security|mirrors.aliyun.com/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    supervisor \
    unzip \
    zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -d /home/ubuntu -s /bin/bash ubuntu \
    && mkdir -p /home/ubuntu/upload /home/ubuntu/workspace \
    && chown -R ubuntu:ubuntu /home/ubuntu

WORKDIR /app

RUN pip install --no-cache-dir \
    "email-validator>=2.3.0" \
    "fastapi>=0.121.2" \
    "pydantic>=2.12.4" \
    "pydantic-settings>=2.12.0" \
    "python-multipart>=0.0.20" \
    "uvicorn>=0.38.0"

COPY app ./app
COPY supervisord.lightweight.conf /etc/supervisor/conf.d/app.conf

RUN chown -R ubuntu:ubuntu /app /etc/supervisor/conf.d/app.conf

USER ubuntu

EXPOSE 8080

CMD ["supervisord", "-n", "-c", "/etc/supervisor/conf.d/app.conf"]
