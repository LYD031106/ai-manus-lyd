{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/s127/featureset.schema.json",
  "title": "S-127 要素清单（build_gml.py 的输入）",
  "type": "object",
  "required": [
    "dataset",
    "features"
  ],
  "additionalProperties": true,
  "properties": {
    "dataset": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^127CN00[A-Za-z0-9_]{1,10}$",
          "description": "数据集名称：127CN00 + 地域 + 专题 + 序号，8~17 字符"
        },
        "title": {
          "type": "string",
          "description": "默认同 name"
        },
        "referenceDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "updateNumber": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "agency": {
          "type": "string",
          "default": "CN"
        },
        "featureIdStart": {
          "type": "integer",
          "minimum": 1,
          "description": "s100:featureIdentificationNumber 起始值，同发布体系内不得重复"
        }
      }
    },
    "common": {
      "type": "object",
      "description": "自动下发给所有非 reusable 要素的共同属性",
      "properties": {
        "fixedDateRange": {
          "$ref": "#/definitions/fixedDateRange"
        },
        "sourceIndication": {
          "$ref": "#/definitions/sourceIndication"
        }
      }
    },
    "geometries": {
      "type": "object",
      "description": "键名任取，被 features[].geometry 引用",
      "additionalProperties": {
        "$ref": "#/definitions/geometry"
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/feature"
      }
    }
  },
  "definitions": {
    "bilingualText": {
      "description": "单值文本属性的双语写法：先英文后中文，脚本用 CR 连成一格",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 2
        },
        {
          "type": "object",
          "properties": {
            "eng": {
              "type": "string"
            },
            "zho": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "featureName": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "eng": {
              "type": "string"
            },
            "zho": {
              "type": "string"
            },
            "displayName": {
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "eng"
              ]
            },
            {
              "required": [
                "zho"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "language",
              "name"
            ],
            "properties": {
              "language": {
                "enum": [
                  "eng",
                  "zho"
                ]
              },
              "name": {
                "type": "string"
              },
              "displayName": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "fixedDateRange": {
      "type": "object",
      "properties": {
        "dateStart": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dateEnd": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "sourceIndication": {
      "type": "object",
      "properties": {
        "categoryOfAuthority": {
          "type": "string"
        },
        "countryName": {
          "$ref": "#/definitions/bilingualText"
        },
        "reportedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "$ref": "#/definitions/bilingualText"
        },
        "sourceType": {
          "enum": [
            "industry publications and reports",
            "law or regulation",
            "mariner report, confirmed",
            "mariner report, not confirmed",
            "news media",
            "official publication",
            "photographs",
            "products issued by HO services",
            "remotely sensed images",
            "traffic data"
          ]
        },
        "featureName": {
          "$ref": "#/definitions/featureName"
        }
      },
      "additionalProperties": false
    },
    "information": {
      "description": "双语成对写法（推荐）或显式单语写法",
      "type": "object",
      "properties": {
        "headline": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "eng": {
                  "type": "string"
                },
                "zho": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "eng": {
                  "type": "string"
                },
                "zho": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "language": {
          "enum": [
            "eng",
            "zho"
          ]
        },
        "eng": {
          "type": "string"
        },
        "zho": {
          "type": "string"
        },
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "textContent": {
      "type": "object",
      "required": [
        "categoryOfText"
      ],
      "properties": {
        "categoryOfText": {
          "enum": [
            "abstract or summary",
            "extract",
            "full text"
          ]
        },
        "information": {
          "oneOf": [
            {
              "$ref": "#/definitions/information"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/information"
              }
            }
          ]
        },
        "sourceIndication": {
          "oneOf": [
            {
              "$ref": "#/definitions/sourceIndication"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/sourceIndication"
              }
            }
          ]
        },
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "surface",
            "polygon",
            "area",
            "curve",
            "line",
            "linestring",
            "point",
            "pt"
          ]
        },
        "exterior": {
          "$ref": "#/definitions/ring"
        },
        "interiors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ring"
          }
        },
        "coordinates": {
          "oneOf": [
            {
              "$ref": "#/definitions/ring"
            },
            {
              "$ref": "#/definitions/position"
            }
          ]
        },
        "$name": {
          "type": "string",
          "description": "仅注释用（coords.py --group-col 的分组名）"
        },
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      },
      "description": "[纬度, 经度]，EPSG:4326 轴序，切勿调换"
    },
    "ring": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/position"
      }
    },
    "association": {
      "type": "object",
      "required": [
        "role",
        "target"
      ],
      "properties": {
        "role": {
          "enum": [
            "componentOf",
            "consistsOf",
            "controlAuthority",
            "informationProvidedFor",
            "isApplicableTo",
            "mustBeFiledBy",
            "partialWorkingDay",
            "permission",
            "positions",
            "providesInformation",
            "reportTo",
            "reptForTrafficServ",
            "serviceArea",
            "serviceProvider",
            "theApplicableRxN",
            "theAuthority",
            "theAuthority_srvHrs",
            "theContactDetails",
            "theInformation",
            "theOrganisation",
            "theRxN",
            "theServiceHours",
            "theServiceHours_nsdy",
            "theShipReport",
            "vslLocation"
          ],
          "description": "S127.xsd 的 gml:ReferenceType 子元素名。哪个角色能挂在哪个要素类上由 XSD 决定，见 references/02 §二"
        },
        "target": {
          "type": "string",
          "description": "目标要素的 ref"
        },
        "permission": {
          "enum": [
            "not recommended",
            "not required",
            "permitted",
            "prohibited",
            "recommended",
            "required"
          ],
          "description": "PermissionType；GML 不承载，导出到补录清单供系统内补选"
        },
        "inclusion": {
          "enum": [
            "excluded",
            "included"
          ],
          "description": "InclusionType；同上"
        },
        "source": {
          "type": "string",
          "description": "条文出处，只进补录清单与记录表"
        },
        "note": {
          "type": "string"
        },
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": [
        "ref",
        "type",
        "featureName"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "数据集内唯一的逻辑标识，用于关联引用"
        },
        "type": {
          "enum": [
            "Applicability",
            "Authority",
            "CautionArea",
            "ConcentrationOfShippingHazardArea",
            "ContactDetails",
            "IspsCodeSecurityLevel",
            "LocalPortServiceArea",
            "MilitaryPracticeArea",
            "NauticalInformation",
            "NonStandardWorkingDay",
            "PilotBoardingPlace",
            "PilotService",
            "PilotageDistrict",
            "PiracyRiskArea",
            "PlaceOfRefuge",
            "RadarRange",
            "RadioCallingInPoint",
            "Recommendations",
            "Regulations",
            "RestrictedAreaNavigational",
            "RestrictedAreaRegulatory",
            "Restrictions",
            "RouteingMeasure",
            "ServiceHours",
            "ShipReport",
            "ShipReportingServiceArea",
            "SignalStationTraffic",
            "SignalStationWarning",
            "UnderkeelClearanceAllowanceArea",
            "UnderkeelClearanceManagementArea",
            "VesselTrafficServiceArea",
            "WaterwayArea"
          ],
          "description": "S-127 要素类名（S127.xsd 全局元素）。关联类 PermissionType/InclusionType 不在此列 —— 用 associations 的 permission/inclusion 字段并配 build_gml.py --assoc-objects"
        },
        "reusable": {
          "type": "boolean",
          "description": "可复用要素不下发 common（即不填来源）；Authority/ContactDetails/ServiceHours/Applicability/NonStandardWorkingDay 默认 true"
        },
        "featureName": {
          "$ref": "#/definitions/featureName"
        },
        "fixedDateRange": {
          "$ref": "#/definitions/fixedDateRange"
        },
        "sourceIndication": {
          "$ref": "#/definitions/sourceIndication"
        },
        "textContent": {
          "oneOf": [
            {
              "$ref": "#/definitions/textContent"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/textContent"
              }
            }
          ]
        },
        "attributes": {
          "type": "object",
          "description": "该要素类的专有属性。枚举写 label，脚本自动补 code",
          "additionalProperties": true
        },
        "geometry": {
          "type": "string",
          "description": "geometries 里的键名（仅地理要素）"
        },
        "associations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/association"
          }
        },
        "clause": {
          "type": "string",
          "description": "条款出处；只进记录表，不进 GML"
        },
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "description": "build_gml.py / validate_featureset.py 的输入格式。S-127 本身的约束（要素类、子元素、必填、枚举）由 schemas/S127.xsd 决定，本 schema 只描述这份 JSON 的写法。"
}
