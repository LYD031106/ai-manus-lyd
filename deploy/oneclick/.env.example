# 离线包的镜像版本。通常无需修改。
BUNDLE_VERSION=20260808
FRONTEND_PORT=80

# OpenAI 兼容接口（当前部署使用 DeepSeek）。
API_KEY=请填写模型API密钥
API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=manus
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

AUTH_PROVIDER=local
LOCAL_AUTH_EMAIL=admin@example.com
LOCAL_AUTH_PASSWORD=请设置管理员密码
JWT_SECRET_KEY=请替换为足够长的随机字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 每个对话仍有独立 Sandbox 容器；以下是单个容器的资源上限。
SANDBOX_IMAGE=ai-manus-oneclick/sandbox:20260808
SANDBOX_NAME_PREFIX=sandbox-
SANDBOX_TTL_MINUTES=30
SANDBOX_NETWORK=manus-network
SANDBOX_MEM_LIMIT=256m
SANDBOX_NANO_CPUS=500000000
SANDBOX_PIDS_LIMIT=64
