**
!.dockerignore
!backend/
!backend/app/
!backend/app/**
!backend/Dockerfile
!backend/Dockerfile.lightweight
!backend/pyproject.toml
!backend/README.md
!backend/start_worker.sh
!backend/scripts/
!backend/scripts/*.py
!backend/scripts/*.md
!sandbox/
!sandbox/app/
!sandbox/app/**
!sandbox/Dockerfile
!sandbox/Dockerfile.lightweight
!sandbox/pyproject.toml
!sandbox/README.md
!sandbox/supervisord.conf
!sandbox/supervisord.lightweight.conf
!builtin_skills/
!builtin_skills/s127-gml/
!builtin_skills/s127-gml/**

# Never include local secrets or generated caches from allowed source folders.
**/.env
**/.env.*
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.pytest_cache/**
**/.venv
**/.venv/**
